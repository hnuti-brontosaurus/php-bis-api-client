{
	"name": "hnuti-brontosaurus/php-bis-api-client",
	"type": "library",
	"description": "API client for Hnutí Brontosaurus IS written in PHP.",
	"authors": [
		{
			"name": "dakur",
			"email": "dev@kurowsti.cz"
		}
	],
	"minimum-stability": "stable",
	"scripts": {
		"phpstan": "phpstan analyze --no-progress --no-interaction -c phpstan.neon"
	},
	"require": {
		"php": ">=8.5",
		"guzzlehttp/guzzle": "^8.0"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.0",
		"tracy/tracy": "^2.5"
	},
	"autoload": {
		"psr-4": {
			"HnutiBrontosaurus\\BisClient\\": "src/"
		},
		"classmap": [
			"src/exceptions.php"
		]
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.5"
		}
	}
}
